    "@types/node": "^22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^5.2.0",
