{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
