// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// The database ID is NEVER committed: the @@wiring(<component>/<env>:<key>)@@ token is
// resolved from the WIRING_CLOUDFLARE_D1_PROBE_STAGE orun secret at deploy time
// (wire-live) or from the committed wiring.fixture.json for offline dry-runs
// (wire-fixture).
//
// openproduct-d1-probe (openproduct-standalone OPN-2): a STAGE-ONLY Worker
// bound to the throwaway `openproduct-probe-stage` D1 database
// (infra/cloudflare-d1-probe), never the product's. There is no prod or dev
// environment here on purpose, and the component subscribes to stage alone.
//
// workers_dev ON: the smoke reaches it at
//   https://openproduct-d1-probe-stage.<CLOUDFLARE_WORKERS_SUBDOMAIN>.workers.dev
// and every route answers a bare 404 without `Authorization: Bearer
// <PROBE_TOKEN>` (a runtime secret, pushed by the composition's secrets-live
// step — never in this file).
{
  "name": "openproduct-d1-probe",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "observability": { "enabled": true },
  // The probe's heaviest request (the export: 5,000 cards parsed and hashed)
  // is a few seconds of CPU; D1 waits do not count against it. Raised so a
  // slow request fails on its own merits, not on the default 30 s ceiling.
  // (Workers Paid; at most 300,000.)
  "limits": { "cpu_ms": 300000 },
  // The slice migration ships inside the bundle as text:
  // `import sliceSql from "@openproduct/db/d1/slice.sql"`.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "stage": {
      "workers_dev": true,
      "preview_urls": false,
      "limits": { "cpu_ms": 300000 },
      "vars": { "ENVIRONMENT": "stage" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openproduct-probe-stage",
          "database_id": "@@wiring(cloudflare-d1-probe/stage:d1_database_id)@@"
        }
      ]
    }
  }
}
